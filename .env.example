# Copy to .env and adjust as needed. Never commit the real .env.

# MongoDB is optional. USE_MONGO: "auto" (use if reachable), "1" (require), "0" (local JSON only).
USE_MONGO=auto
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=product_review_analysis

# Auth - set a strong random secret in production.
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRE_MINUTES=1440

# Frontend dev origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional transformer sentiment (requires: pip install transformers torch).
ENABLE_TRANSFORMER=0
